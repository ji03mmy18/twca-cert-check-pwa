{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["void/env", "vite/client"]
  },
  "include": ["src", "shared", "server", "routes", "test", "vite.config.ts", "void.config.ts", "env.ts"]
}
